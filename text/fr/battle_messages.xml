<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<sn:script xmlns:sn="http://snes.ninja/ScriptNS">
    <sn:pointer id="0">Le dragon s'est changé en brume ![end]</sn:pointer>
    <sn:pointer id="1">Il reprend forme ! C'est le moment d'attaquer ![end]</sn:pointer>
    <sn:pointer id="2">La brume rend toute attaque inutile ![end]</sn:pointer>
    <sn:pointer id="3">Si vous attaquez, son souffle vous terrassera ![end]</sn:pointer>
    <sn:pointer id="4">Frappez quand il reprend forme ![end]</sn:pointer>
    <sn:pointer id="5">Adieu...[end]</sn:pointer>
    <sn:pointer id="6">Argh ! Mon corps se désagrège !![end]</sn:pointer>
    <sn:pointer id="7">Mes chers enfants...[end]</sn:pointer>
    <sn:pointer id="8">...Intrus en cours d'identification...[end]</sn:pointer>
    <sn:pointer id="9">IMBÉCILES ! À MON TOUR D'ATTAQUER ![end]</sn:pointer>
    <sn:pointer id="10">Yang: Inutile... nous ne pouvons pas gagner...[end]</sn:pointer>
    <sn:pointer id="11">Si seulement je pouvais me servir de mon épée...[end]</sn:pointer>
    <sn:pointer id="12">Tella: Bon sang...[end]</sn:pointer>
    <sn:pointer id="13">ALORS JE N'AI PLUS QU'À CHANGER DE FORME ![end]</sn:pointer>
    <sn:pointer id="14">Réveille-toi, Yang ![end]</sn:pointer>
    <sn:pointer id="15">Meurs !![end]</sn:pointer>
    <sn:pointer id="16">C'est Cecil ! Tu ne me reconnais pas ?[end]</sn:pointer>
    <sn:pointer id="17">Yaaah ![end]</sn:pointer>
    <sn:pointer id="18">Aïe...[end]</sn:pointer>
    <sn:pointer id="19">Petite fille: Ça suffit ! J'en peux plus !![end]</sn:pointer>
    <sn:pointer id="20">Qui a vu ma vraie forme ne vivra pas ![end]</sn:pointer>
    <sn:pointer id="21">Anna: Je vous en prie ! Arrêtez, tous les deux ![end]</sn:pointer>
    <sn:pointer id="22">Tella: Misérable ! Ma fille...[end]</sn:pointer>
    <sn:pointer id="23">Barde: Vous vous trompez ![end]</sn:pointer>
    <sn:pointer id="24">Tella: Comment ça, je me trompe ![end]</sn:pointer>
    <sn:pointer id="25">Barde: Écoutez-moi, je vous en prie ![end]</sn:pointer>
    <sn:pointer id="26">Tella: Silence ![end]</sn:pointer>
    <sn:pointer id="27">Barde: Je vous en prie ![end]</sn:pointer>
    <sn:pointer id="28">Tella: Cette douleur, c'est celle d'Anna...[end]</sn:pointer>
    <sn:pointer id="29">Barde: Anna, elle...[end]</sn:pointer>
    <sn:pointer id="30">Si tu es vraiment un paladin...[end]</sn:pointer>
    <sn:pointer id="31">Rengaine ton épée et supporte-le ![end]</sn:pointer>
    <sn:pointer id="32">Plus que la justice, plus que le bon droit...[end]</sn:pointer>
    <sn:pointer id="33">Il y a quelque chose de plus important.[end]</sn:pointer>
    <sn:pointer id="34">Un jour, tu comprendras.[end]</sn:pointer>
    <sn:pointer id="35">Je vais te précipiter du haut de la falaise ![end]</sn:pointer>
    <sn:pointer id="36">Tella: Le moment est-il venu d'utiliser Météore... ?[end]</sn:pointer>
    <sn:pointer id="37">Arrête ! Si tu fais ça...[end]</sn:pointer>
    <sn:pointer id="38">Yang: Folie ! C'est toi qui n'y survivras pas ![end]</sn:pointer>
    <sn:pointer id="39">Tella: Que toute ma vie se change en PM ![end]</sn:pointer>
    <sn:pointer id="40">Toi... je vais t'abattre !![end]</sn:pointer>
    <sn:pointer id="41">Golbez: Quoi... impossible ! Météore...![end]</sn:pointer>
    <sn:pointer id="42">Golbez: Un vieux croûton comme toi...[end]</sn:pointer>
    <sn:pointer id="43">...n'a pas la force de me vaincre ![end]</sn:pointer>
    <sn:pointer id="44">Pauvre fou ![end]</sn:pointer>
    <sn:pointer id="45">Mag: Maintenant, Rag ! Lance ta magie sur moi ![end]</sn:pointer>
    <sn:pointer id="46">De face, le vent nous empêche de voir ![end]</sn:pointer>
    <sn:pointer id="47">Il faut frapper en sautant ![end]</sn:pointer>
    <sn:pointer id="48">Roi: Vous aussi ? Si vous tenez tant à mourir...[end]</sn:pointer>
    <sn:pointer id="49">Je vais tous vous réduire en sable infernal ![end]</sn:pointer>
    <sn:pointer id="50">Edge: Qu'est-ce qui vous arrive !?[end]</sn:pointer>
    <sn:pointer id="51">Papa ! Maman ![end]</sn:pointer>
    <sn:pointer id="52">Edge: C'est moi ! Hé...[end]</sn:pointer>
    <sn:pointer id="53">Le roi et la reine ont retrouvé la raison ![end]</sn:pointer>
    <sn:pointer id="54">Roi: Edge... Écoute-moi bien.[end]</sn:pointer>
    <sn:pointer id="55">Nous ne sommes plus humains...[end]</sn:pointer>
    <sn:pointer id="56">Nous sommes des êtres qui ne doivent pas vivre.[end]</sn:pointer>
    <sn:pointer id="57">Reine: Nous n'avons rien à te laisser...[end]</sn:pointer>
    <sn:pointer id="58">Pourquoi, Caïn !?[end]</sn:pointer>
    <sn:pointer id="59">Assez de questions ![end]</sn:pointer>
    <sn:pointer id="60">Que s'est-il passé !?[end]</sn:pointer>
    <sn:pointer id="61">Tais-toi ![end]</sn:pointer>
    <sn:pointer id="62">Cecil ! Achève-le ![end]</sn:pointer>
    <sn:pointer id="63">Je vais ex-plo-seeer ![end]</sn:pointer>
    <sn:pointer id="64">Anna: Du courage ![end]</sn:pointer>
    <sn:pointer id="65">A-Anna ![end]</sn:pointer>
    <sn:pointer id="66">Tu n'es pas aussi faible que tu le penses.[end]</sn:pointer>
    <sn:pointer id="67">Crois en toi ![end]</sn:pointer>
    <sn:pointer id="68">Je vais essayer, Anna ![end]</sn:pointer>
    <sn:pointer id="69">Argh, gloups ![end]</sn:pointer>
    <sn:pointer id="70">Il rassemble l'eau pour un raz-de-marée ![end]</sn:pointer>
    <sn:pointer id="71">Il se renferme pour se défendre ![end]</sn:pointer>
    <sn:pointer id="72">Tella: Digne d'un chevalier noir ![end]</sn:pointer>
    <sn:pointer id="73">Mais tes gestes ont ralenti ![end]</sn:pointer>
    <sn:pointer id="74">Golbez: Ha ha ha ha ![end]</sn:pointer>
    <sn:pointer id="75">C'est donc ça, votre force...[end]</sn:pointer>
    <sn:pointer id="76">Tenez-vous tranquilles un moment ![end]</sn:pointer>
    <sn:pointer id="77">Figés, il ne vous reste que vos yeux...[end]</sn:pointer>
    <sn:pointer id="78">...pour goûter la vraie terreur ![end]</sn:pointer>
    <sn:pointer id="79">Viens, Dragon Noir ![end]</sn:pointer>
    <sn:pointer id="80">Golbez: Cecil, à ton tour ![end]</sn:pointer>
    <sn:pointer id="81">Capitaine: À l'assaut ![end]</sn:pointer>
    <sn:pointer id="82">Général: Chargez ![end]</sn:pointer>
    <sn:pointer id="83">Golbez: Le dragon...[end]</sn:pointer>
    <sn:pointer id="84">????: Ça va, je peux bouger ![end]</sn:pointer>
    <sn:pointer id="85">Cette voix...[end]</sn:pointer>
    <sn:pointer id="86">Moi... vaincu...[end]</sn:pointer>
    <sn:pointer id="87">Docteur: Va, Barnabas ! Réduis-les en miettes ![end]</sn:pointer>
    <sn:pointer id="88">Barnabas: Ouga ![end]</sn:pointer>
    <sn:pointer id="89">Docteur: Aïe ! Pourquoi tu me frappes, moi ?[end]</sn:pointer>
    <sn:pointer id="90">Là-bas ! Là-bas, compris ?[end]</sn:pointer>
    <sn:pointer id="91">Docteur: Bien, montre-leur ta puissance ![end]</sn:pointer>
    <sn:pointer id="92">Docteur: Vous avez osé... mon Barnabas chéri ![end]</sn:pointer>
    <sn:pointer id="93">Docteur: Dans ce cas, je vais moi-même...[end]</sn:pointer>
    <sn:pointer id="94">piloter Barnabas ![end]</sn:pointer>
    <sn:pointer id="95">Docteur: Pas question de tomber en panne d'huile ![end]</sn:pointer>
    <sn:pointer id="96">Barnabas: Hu...i...le...s'il...vous...plaît...[end]</sn:pointer>
    <sn:pointer id="97">Je vais vous montrer la vraie terreur ![end]</sn:pointer>
    <sn:pointer id="98">Transformation ![end]</sn:pointer>
    <sn:pointer id="99">Docteur: Hein, c'est quoi ce bouton... ◉Clic[end]</sn:pointer>
    <sn:pointer id="100">Dog: Grande sœur, on y va ![end]</sn:pointer>
    <sn:pointer id="101">Rag: Mag, renvoie-le ![end]</sn:pointer>
    <sn:pointer id="102">Les trois sœurs Magus: Attaque Delta !![end]</sn:pointer>
    <sn:pointer id="103">Tu vas mourir.[end]</sn:pointer>
    <sn:pointer id="104">Le courant électrique a transpercé Odin ![end]</sn:pointer>
    <sn:pointer id="105">Rubicante: Quelle technique pitoyable...[end]</sn:pointer>
    <sn:pointer id="106">Un jour, je renaîtrai, c'est certain.[end]</sn:pointer>
    <sn:pointer id="107">Voilà comment on se sert du feu ![end]</sn:pointer>
    <sn:pointer id="108">Edge: ...[end]</sn:pointer>
    <sn:pointer id="109">Roi: Tant que nous avons encore notre raison...[end]</sn:pointer>
    <sn:pointer id="110">nous devons partir d'ici...[end]</sn:pointer>
    <sn:pointer id="111">Nous comptons sur toi, Edge.[end]</sn:pointer>
    <sn:pointer id="112">Edge: Non ! Ne partez pas ![end]</sn:pointer>
    <sn:pointer id="113">Reine: Adieu, Edge.[end]</sn:pointer>
    <sn:pointer id="114">Edge: Attends ! Maman ![end]</sn:pointer>
    <sn:pointer id="115">Noooon――[end]</sn:pointer>
    <sn:pointer id="116">L'élément foudre a brisé la barrière ![end]</sn:pointer>
    <sn:pointer id="117">Tous les effets magiques ont été annulés ![end]</sn:pointer>
    <sn:pointer id="118">Maladroit ![end]</sn:pointer>
    <sn:pointer id="119">Ah[end]</sn:pointer>
    <sn:pointer id="120">           5[end]</sn:pointer>
    <sn:pointer id="121">           4[end]</sn:pointer>
    <sn:pointer id="122">           3[end]</sn:pointer>
    <sn:pointer id="123">           2[end]</sn:pointer>
    <sn:pointer id="124">           1[end]</sn:pointer>
    <sn:pointer id="125">Les poupées fusionnent ![end]</sn:pointer>
    <sn:pointer id="126">La fusion est rompue ![end]</sn:pointer>
    <sn:pointer id="127">FuSoYa: Encore un effort ! Toute la force à Météore ![end]</sn:pointer>
    <sn:pointer id="128">Golbez: Avec plaisir ![end]</sn:pointer>
    <sn:pointer id="129">Zémus: Utilise donc toute ta puissance.[end]</sn:pointer>
    <sn:pointer id="130">Zémus: Même si ce corps périt...[end]</sn:pointer>
    <sn:pointer id="131">mon âme... est... im... mor... telle...[end]</sn:pointer>
    <sn:pointer id="132">FuSoYa: Inutile, Météore n'a aucun effet sur lui ![end]</sn:pointer>
    <sn:pointer id="133">Golbez ! C'est le moment d'utiliser les cristaux ![end]</sn:pointer>
    <sn:pointer id="134">Zéromus: Toi qui as suivi la voie des ténèbres...[end]</sn:pointer>
    <sn:pointer id="135">Même avec les cristaux, la lumière ne reviendra pas.[end]</sn:pointer>
    <sn:pointer id="136">Tu ne peux que retourner aux ténèbres ![end]</sn:pointer>
    <sn:pointer id="137">Coâ coâ, chante ![end]</sn:pointer>
    <sn:pointer id="138">Un monstre a surgi de la porte ![end]</sn:pointer>
    <sn:pointer id="139">Tu es encore trop vert ![end]</sn:pointer>
    <sn:pointer id="140">Regarde un peu mon statut ![end]</sn:pointer>
    <sn:pointer id="141">Faible face aux nuits blanches.[end]</sn:pointer>
    <sn:pointer id="142">Faible face aux filles à lunettes.[end]</sn:pointer>
    <sn:pointer id="143">Rubicante: Ici, je m'avoue vaincu, mais...[end]</sn:pointer>
    <sn:pointer id="144">Faible en tout.[end]</sn:pointer>
    <sn:pointer id="145">Ça ne devait pas se passer comme ça...[end]</sn:pointer>
    <sn:pointer id="146">Frapper un pauvre type comme moi !?[end]</sn:pointer>
    <sn:pointer id="147">Aïe, pitié ![end]</sn:pointer>
    <sn:pointer id="148">Vas-y, Cecil ![end]</sn:pointer>
    <sn:pointer id="149">Maître Zémus... rapport...[end]</sn:pointer>
    <sn:pointer id="150">Tu veux entendre mon morceau de violon préféré ?[end]</sn:pointer>
    <sn:pointer id="151">Pas vraiment...[end]</sn:pointer>
    <sn:pointer id="152">Ah bon...[end]</sn:pointer>
    <sn:pointer id="153">Dansons ensemble ![end]</sn:pointer>
    <sn:pointer id="154">Edward: Courage, tout le monde ![end]</sn:pointer>
    <sn:pointer id="155">Tella: Quand on veut, on peut ! Crois en toi ![end]</sn:pointer>
    <sn:pointer id="156">Leurs vœux t'ont donné la force de tenir ![end]</sn:pointer>
    <sn:pointer id="157">Palom: Grand frère ![end]</sn:pointer>
    <sn:pointer id="158">Porom: On t'envoie notre magie ![end]</sn:pointer>
    <sn:pointer id="159">Leur tendresse t'a donné la force de vivre ![end]</sn:pointer>
    <sn:pointer id="160">Yang: Concentre ton esprit ![end]</sn:pointer>
    <sn:pointer id="161">Cid: Reviens-nous, surtout ![end]</sn:pointer>
    <sn:pointer id="162">Leurs prières t'ont donné la force de tenir ![end]</sn:pointer>
    <sn:pointer id="163">FuSoYa: Ô lune, accorde-nous ta lumière ![end]</sn:pointer>
    <sn:pointer id="164">Golbez: Mon frère ![end]</sn:pointer>
    <sn:pointer id="165">Le pouvoir sacré qui dort en toi...[end]</sn:pointer>
    <sn:pointer id="166">confie-le au cristal ![end]</sn:pointer>
    <sn:pointer id="167">Zéromus ! Montre-nous ta véritable forme ![end]</sn:pointer>
    <sn:pointer id="168">Leurs cœurs t'ont donné la lumière sacrée ![end]</sn:pointer>
    <sn:pointer id="169">Zéromus: Ga... Gu... Gu... Go...[end]</sn:pointer>
    <sn:pointer id="170">Que mes gaz fassent de toi un cadavre ambulant ![end]</sn:pointer>
    <sn:pointer id="171">Meurs ![end]</sn:pointer>
    <sn:pointer id="172">La vraie forme de Zéromus est révélée ![end]</sn:pointer>
    <sn:pointer id="173">Frapper un programmeur de combats ![end]</sn:pointer>
    <sn:pointer id="174">Espèce de... je vais m'autodétruire ![end]</sn:pointer>
    <sn:pointer id="175">Hé hé, tu es tombé dans le panneau ![end]</sn:pointer>
    <sn:pointer id="176">Effacer le Dragon Noir par le pouvoir de la brume...[end]</sn:pointer>
    <sn:pointer id="177">Je vous tuerai et je mourrai avec vous ![end]</sn:pointer>
    <sn:pointer id="178">Je vais te renvoyer cet éclair au double ![end]</sn:pointer>
    <sn:pointer id="179">Pourquoi tu me réveilles ? C'était le meilleur moment ![end]</sn:pointer>
    <sn:pointer id="180">Bon, voyons la suite...[end]</sn:pointer>
    <sn:pointer id="181">Alors, qui commence ?[end]</sn:pointer>
    <sn:pointer id="182">Gérant: Hiromi, on vous demande ![end]</sn:pointer>
    <sn:pointer id="183">Bientôt je serai papa, ahhh.[end]</sn:pointer>
    <sn:pointer id="184">Sympa, non ?[end]</sn:pointer>
    <sn:pointer id="185">Salut alors, ahhh.[end]</sn:pointer>
</sn:script>